.venv/
venv/
__pycache__/
*.py[cod]
*.pid

# Local Next.js launcher output
next-local.log

# Local SQLite snapshots created before destructive development resets
/db/*.backup.db
# Skills directory
/skills/

# Local SQLite database files
/db/*.db

# Keep the shareable environment template
!.env.example
